# SwiftPM
.build/
.swiftpm/
Package.resolved

# Build output
build/

# Stray compiler output. SwiftPM normally keeps these in .build/, but an interrupted or
# incremental build can drop them at the repo root, where they're easy to commit by accident.
*.o
*.d
*.swiftdeps

# macOS
.DS_Store

# Agent tooling
.agentctl/
.claude/

# Agent worktrees. Created inside the repo by tooling that branches from it; a
# failed launch can leave one behind, and a nested checkout must never be committed.
.worktrees/
